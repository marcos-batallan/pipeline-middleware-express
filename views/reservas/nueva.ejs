<section class="formulario-reserva">
    <h1><%= seccion %>: Nueva reserva</h1>

    <% if (errores && errores.length > 0) { %>
        <div class="mensaje-error" role="alert">
            <p>Revisa los siguientes datos:</p>
            <ul>
                <% errores.forEach((error) => { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <form action="/reservas" method="post" novalidate>
        <div class="campo">
            <label for="estudiante">Estudiante</label>
            <input
                type="text"
                id="estudiante"
                name="estudiante"
                value="<%= valores.estudiante || '' %>"
                required
            >
        </div>

        <div class="campo">
            <label for="email">Email</label>
            <input
                type="text"
                id="email"
                name="email"
                value="<%= valores.email || '' %>"
                required
            >
        </div>

        <div class="campo">
            <label for="sala">Sala</label>
            <select name="sala" id="sala" required>
                <option value="" disabled <%= !valores.sala ? "selected" : "" %>>Elegí una sala</option>
                <% salasPermitidas.forEach((sala) => { %>
                    <option value="<%= sala %>" <%= valores.sala === sala ? "selected" : "" %>>
                        <%= sala %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="campo">
            <label for="fecha">Fecha</label>
            <input 
                type="date"
                id="fecha"
                name="fecha"
                value="<%= valores.fecha || '' %>"
                required
            >
        </div>

        <div class="campo">
            <label for="turno">Turno</label>
            <select name="turno" id="turno" required>
                <option value="" disabled <%= !valores.turno ? "selected" : "" %>>Elegí un turno</option>
                <% turnosPermitidos.forEach((turno) => { %>
                    <option value="<%= turno %>" <%= valores.turno === turno ? "selected" : "" %>>
                        <%= turno %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="campo">
            <label for="personas">Cantidad de personas</label>
            <input 
                type="number"
                id="personas"
                name="personas"
                min="1"
                max="6"
                value="<%= valores.personas || '' %>"
                required
            >
        </div>

        <button type="submit" class="boton">Confirmar la reserva</button>
    </form>
</section>